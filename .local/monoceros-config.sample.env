# Global settings shared across all your Monoceros containers - optional
# defaults and credentials, so you don't repeat them in every container's
# container-configs/<name>.env (which overrides anything set here).
# Monoceros runs fine without this file. Never commit real tokens.

# Machine-wide settings. These two are read from this file only.
# Port of the local proxy that serves http://<name>.localhost. Change it when
# port 80 is taken on this machine. The URLs then carry the port.
# https://getmonoceros.build/docs/concepts/monoceros-proxy/
# MONOCEROS_HOST_PORT=80
# Days after the last `monoceros upgrade` before apply reminds you to run it.
# MONOCEROS_UPGRADE_STALE_DAYS=30

# Git identity for commits in every workbench
# https://getmonoceros.build/docs/concepts/git-and-repos/
# GIT_USER_NAME=
# GIT_USER_EMAIL=

# Git: GitHub and GitLab repositories, plus the gh and glab CLIs
# https://getmonoceros.build/docs/concepts/git-and-repos/
# GITHUB_API_TOKEN=
# GITLAB_API_TOKEN=
# GIT_TOKEN__GITHUB_ACME=
# GIT_TOKEN__GITLAB_MYGROUP=

# Atlassian: Rovo Dev, twg, and Forge, plus Bitbucket
# https://getmonoceros.build/docs/features/atlassian/
# ATLASSIAN_EMAIL=
# ATLASSIAN_INSTANCE=yoursite.atlassian.net
# Three tokens, because no single one covers all three sides: the Teamwork
# Graph app for twg and Forge, the Rovo Dev app for acli, and Bitbucket for
# clone and push. Each is a scoped token from id.atlassian.com.
# ATLASSIAN_API_TOKEN=
# ATLASSIAN_ROVODEV_TOKEN=
# ATLASSIAN_BITBUCKET_TOKEN=
