# Settings and secrets for every Monoceros workbench on this machine.
# A workbench's own container-configs/<name>.env overrides a value set here.
# Monoceros runs fine without this file. Never commit it.

# Proxy port for http://<name>.localhost. Change it when port 80 is taken.
# Read from this file only.
# MONOCEROS_HOST_PORT=80

# Days after the last `monoceros upgrade` before apply reminds you.
# Read from this file only.
# MONOCEROS_UPGRADE_STALE_DAYS=30

# Git identity for commits in every workbench
# GIT_USER_NAME=
# GIT_USER_EMAIL=

# GitHub and GitLab tokens: clone, push, and the gh / glab CLIs
# https://getmonoceros.build/docs/concepts/git-and-repos/
# GITHUB_API_TOKEN=
# GITLAB_API_TOKEN=
