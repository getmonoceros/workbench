# Settings and secrets for every Monoceros workbench on this machine.
# A workbench's own container-configs/<name>.env overrides a value set here.
# Monoceros runs fine without this file. Never commit it.

# Proxy port for http://<name>.localhost. Change it when port 80 is taken.
# Read from this file only.
# MONOCEROS_HOST_PORT=80

# Days after the last `monoceros upgrade` before apply reminds you.
# Read from this file only.
# MONOCEROS_UPGRADE_STALE_DAYS=30

# Limit every container to its default memory and CPU, also where the yml
# sets no limit. For a machine that runs workbenches unattended. A limit
# written in the yml applies either way.
# Read from this file only.
# MONOCEROS_ENFORCE_DEFAULT_LIMITS=false

# Git identity for commits in every workbench
# GIT_USER_NAME=
# GIT_USER_EMAIL=

# Repository tokens: clone and push, plus the gh / glab CLIs
# https://getmonoceros.build/docs/concepts/git-and-repos/
# GITHUB_API_TOKEN=
# GITLAB_API_TOKEN=
# ATLASSIAN_BITBUCKET_TOKEN=

# Model and effort per agent role, for every workbench with agent-roles.
# Its roles: block references these, and init and add-feature ask for the
# ones set nowhere. Empty means the session's model. A workbench's own
# <name>.env overrides them.
# https://getmonoceros.build/docs/features/agent-roles/
# AGENT_ROLES_CLAUDE_PLANNER_MODEL=opus
# AGENT_ROLES_CLAUDE_PLANNER_EFFORT=high
# AGENT_ROLES_CLAUDE_DEVELOPER_MODEL=sonnet
# AGENT_ROLES_CLAUDE_DEVELOPER_EFFORT=medium
# AGENT_ROLES_CLAUDE_REVIEWER_MODEL=opus
# AGENT_ROLES_CLAUDE_REVIEWER_EFFORT=high
# AGENT_ROLES_OPENCODE_PLANNER_MODEL=openrouter/moonshotai/kimi-k3
# AGENT_ROLES_OPENCODE_PLANNER_EFFORT=high
# AGENT_ROLES_OPENCODE_DEVELOPER_MODEL=openrouter/moonshotai/kimi-k2.7-code
# AGENT_ROLES_OPENCODE_DEVELOPER_EFFORT=
# AGENT_ROLES_OPENCODE_REVIEWER_MODEL=openrouter/moonshotai/kimi-k3
# AGENT_ROLES_OPENCODE_REVIEWER_EFFORT=high
# AGENT_ROLES_COPILOT_PLANNER_MODEL=gpt-6-astra
# AGENT_ROLES_COPILOT_PLANNER_EFFORT=high
# AGENT_ROLES_COPILOT_DEVELOPER_MODEL=gpt-6-astra
# AGENT_ROLES_COPILOT_DEVELOPER_EFFORT=medium
# AGENT_ROLES_COPILOT_REVIEWER_MODEL=gpt-6-astra
# AGENT_ROLES_COPILOT_REVIEWER_EFFORT=high
